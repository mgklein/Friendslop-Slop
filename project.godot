; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Friendslop-Slop"
run/main_scene="uid://dmtbw4gyydpei"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TileRunInstancesGlobal="*uid://b6fg6pu2bfi14"
Network="*uid://cmacc0qaxcb7t"
Global="*uid://g7esakolnc6k"

[display]

window/size/viewport_width=720
window/size/viewport_height=360
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/tile-run-instances/plugin.cfg", "res://addons/tube/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "green",
"res://levels/": "orange",
"res://scenes/": "red",
"res://scripts/": "yellow"
}

[importer_defaults]

animation_library={
&"import_script/path": "uid://dwbm13dvv8c1m"
}
scene={
"_subresources": {},
"animation/fps": 30,
"animation/import": true,
"animation/import_rest_as_RESET": false,
"animation/remove_immutable_tracks": true,
"animation/trimming": false,
"array_mesh/deduplicate_surfaces": true,
"gltf/embedded_image_handling": 1,
"gltf/naming_version": 2,
"gltf/texture_map_mode": 1,
&"import_script/path": "uid://dwbm13dvv8c1m",
"materials/extract": 0,
"materials/extract_format": 0,
"materials/extract_path": "",
"mesh_library/use_node_names_as_mesh_names": false,
"meshes/create_shadow_meshes": true,
"meshes/ensure_tangents": true,
"meshes/force_disable_compression": false,
"meshes/generate_lods": true,
"meshes/light_baking": 1,
"meshes/lightmap_texel_size": 0.2,
"nodes/apply_root_scale": true,
"nodes/import_as_skeleton_bones": false,
"nodes/root_name": "",
"nodes/root_scale": 1.0,
"nodes/root_script": null,
"nodes/root_type": "",
"nodes/use_name_suffixes": true,
"nodes/use_node_type_suffixes": true,
"skins/use_named_skins": true
}

